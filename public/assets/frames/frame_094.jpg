<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
    <defs>
      <radialGradient id="bg" cx="50%" cy="50%" r="70%">
        <stop offset="0%" stop-color="#1f070a"/>
        <stop offset="60%" stop-color="#0e0405"/>
        <stop offset="100%" stop-color="#0a0404"/>
      </radialGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="15" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    <rect width="1280" height="720" fill="url(#bg)"/>
    <g filter="url(#glow)">
      <circle cx="640" cy="360" r="223.2" fill="none" stroke="#ff1e2d" stroke-width="2" stroke-dasharray="15 10" opacity="0.80"/>
      <circle cx="640" cy="360" r="124" fill="none" stroke="#ff4d5a" stroke-width="1.5" opacity="0.80"/>
      <text x="640" y="365" fill="#ffffff" font-family="sans-serif" font-size="28" font-weight="bold" text-anchor="middle" letter-spacing="4" opacity="0.80">ABHAY_GUPTA // FRAME 094</text>
    </g>
  </svg>